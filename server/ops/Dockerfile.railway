# Candidate release image; production activation requires coordinated migration.
# Context: a host-verified release-root tar streamed by build-release-image.js.
# Official Node tag verified 2026-09-22; pin the linux/amd64 image, not a mutable tag.
FROM node:22.23.1-bookworm-slim@sha256:8607a9064d4a571140998ae9e52a3b3fcf9cff361d04642d5971e6cd76d39e27 AS verified-source
ARG RELEASE_MANIFEST_SHA256
# Defense in depth after the trusted host verifies the exact tar bytes. All
# downstream COPY instructions read exclusively from this captured stage.
COPY . /release/
RUN node /release/server/ops/stage-release.js verify /release "$RELEASE_MANIFEST_SHA256"

FROM node:22.23.1-bookworm-slim@sha256:8607a9064d4a571140998ae9e52a3b3fcf9cff361d04642d5971e6cd76d39e27 AS build
ARG RELEASE_MANIFEST_SHA256
LABEL org.easynews.release-manifest-sha256="${RELEASE_MANIFEST_SHA256}"
RUN apt-get update && apt-get install -y --no-install-recommends build-essential python3 libseccomp-dev \
      poppler-utils=22.12.0-2+deb12u3 libpoppler126=22.12.0-2+deb12u3 \
      fonts-dejavu-core=2.37-6 fontconfig=2.14.1-4 tesseract-ocr=5.3.0-2 tesseract-ocr-eng=1:4.1.0-2 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=verified-source /release/server/package.json /release/server/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY --from=verified-source /release/server/evidence/ ./evidence/
COPY --from=verified-source /release/server/ops/build-parser-bundle.js ./ops/build-parser-bundle.js
COPY --from=verified-source /release/server/ops/build-pdf-bundle.js ./ops/build-pdf-bundle.js
RUN cc -Wall -Wextra -Werror -DPARSER_SANDBOX_READONLY_SCRATCH evidence/native/parser-sandbox.c -lseccomp -o /tmp/parser-launcher \
    && cc -Wall -Wextra -Werror evidence/native/pdf-render.c -o /tmp/pdf-render \
    && node ops/build-parser-bundle.js /opt/easy-parser /tmp/parser-launcher /opt/easy-parser.sha256 \
    && node ops/build-pdf-bundle.js /opt/easy-pdf /tmp/parser-launcher /tmp/pdf-render /opt/easy-pdf.sha256

FROM node:22.23.1-bookworm-slim@sha256:8607a9064d4a571140998ae9e52a3b3fcf9cff361d04642d5971e6cd76d39e27
ARG RELEASE_MANIFEST_SHA256
LABEL org.easynews.release-manifest-sha256="${RELEASE_MANIFEST_SHA256}"
RUN apt-get update && apt-get install -y --no-install-recommends libseccomp2 ca-certificates \
      poppler-utils=22.12.0-2+deb12u3 libpoppler126=22.12.0-2+deb12u3 \
      fonts-dejavu-core=2.37-6 fontconfig=2.14.1-4 tesseract-ocr=5.3.0-2 tesseract-ocr-eng=1:4.1.0-2 \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -m 0700 -o node -g node /tmp/easy-html /tmp/easy-pdf-scratch
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /opt/easy-parser /opt/easy-parser
COPY --from=build /opt/easy-parser.sha256 /opt/easy-parser.sha256
COPY --from=build /opt/easy-pdf /opt/easy-pdf
COPY --from=build /opt/easy-pdf.sha256 /opt/easy-pdf.sha256
# Explicit source allowlist: no COPY ., local databases, environment files or tests.
COPY --from=verified-source /release/server/*.js ./
COPY --from=verified-source /release/server/package.json ./
COPY --from=verified-source /release/server/analysis/ ./analysis/
COPY --from=verified-source /release/server/discovery/ ./discovery/
COPY --from=verified-source /release/server/evidence/ ./evidence/
COPY --from=verified-source /release/server/migrations/ ./migrations/
COPY --from=verified-source /release/server/models/ ./models/
COPY --from=verified-source /release/server/ops/ ./ops/
COPY --from=verified-source /release/server/publication/ ./publication/
COPY --from=verified-source /release/server/retrieval/ ./retrieval/
COPY --from=verified-source /release/server/routes/ ./routes/
# COPY creates the destination root with default directory permissions even when
# the source root was sealed. Preserve the release check's read-only invariant.
RUN chmod 0555 /opt/easy-parser /opt/easy-pdf
ENV NODE_ENV=production
USER node
# DB_PATH is deliberately required; do not initialize/migrate/chown the live
# volume during startup. Coordinate its permissions and migration separately.
CMD ["node", "index.js"]
