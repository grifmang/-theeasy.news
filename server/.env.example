# Runtime configuration example; defaults keep background work disabled.
# Set through the host environment; this file is not loaded automatically.
NODE_ENV=production
# Explicit controlled cutover only; serves health but rejects all application traffic.
MAINTENANCE_MODE=false
# Linux mounted volume; Windows development needs an absolute Windows path.
DB_PATH=/data/easy-news.db
# Optional existing private directory on a persistent volume; required for intake.
ARCHIVE_PATH=/data/originals
GENERATION_ENABLED=false
CLASSIFICATION_ENABLED=false
# Analysis verification can run only with DEPLOYMENT_ENV=staging and explicit budgets/guard.
DEPLOYMENT_ENV=production
ANALYSIS_VERIFICATION_ENABLED=false
# Staging-only private generation-fenced filesystem exporter. Linux private modes
# and directory fsync are required; production Windows activation is rejected.
# The export path must be a dedicated directory outside the database/archive/build.
PUBLICATION_EXPORT_ENABLED=false
# PUBLICATION_EXPORT_PATH=/data/private-publication-export
# Staging-only public API admission. Enabling requires the private exporter and
# a successfully bound/reconciled current sink; loss latches reads closed.
PUBLIC_READ_ENABLED=false
INGESTION_ENABLED=false
# Enable only after the candidate Linux image and single-replica runtime pass release checks.
HTML_EXTRACTION_ENABLED=false
HTML_PARSER_BUNDLE=/opt/easy-parser
HTML_PARSER_DIGEST_FILE=/opt/easy-parser.sha256
HTML_PARSER_SCRATCH=/tmp/easy-html
# Requires separately sealed PDF runtime and explicit schema22 migration.
PDF_EXTRACTION_ENABLED=false
PDF_PARSER_BUNDLE=/opt/easy-pdf
PDF_PARSER_DIGEST_FILE=/opt/easy-pdf.sha256
PDF_PARSER_SCRATCH=/tmp/easy-pdf-scratch
# Operator-reviewed source registry. Empty list deliberately cannot enable ingestion.
# Approval flags document review; they do not themselves enforce robots.txt rules.
SOURCE_POLICIES_JSON=[]
AUTO_PUBLISH_ENABLED=false
DAILY_BUDGET_MICROS=0
MONTHLY_BUDGET_MICROS=0
# Set positive classification limits and MAX_CONCURRENT_MODEL_CALLS=1 before staging analysis opt-in.
CLASSIFICATION_DAILY_BUDGET_MICROS=0
CLASSIFICATION_MONTHLY_BUDGET_MICROS=0
MAX_CONCURRENT_MODEL_CALLS=1
# Existing private directory on persistent storage; required outside test mode for analysis opt-in.
# BUDGET_FAIL_CLOSED_PATH=/data/budget-guard
# Set real values in secret storage only when the corresponding feature is used.
TYPESAFE_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
